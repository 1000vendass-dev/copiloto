# Supabase (públicas — seguras no navegador, protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Endereço público do app (sem barra no fim). Obrigatório no Docker/VPS: links de e-mail e de ficha usam isto.
APP_URL=https://copiloto.1000vendas.com

# IA (somente servidor — nunca prefixar com NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# IA pelo Claude Code da VPS (assinatura). Quando definido, a API paga acima NÃO é usada.
COPILOTO_BRIDGE_URL=http://copiloto-claude:8080
COPILOTO_BRIDGE_TOKEN=

# WhatsApp via WAHA (somente servidor)
# Chave de serviço do Supabase: o webhook grava mensagens ignorando RLS. NUNCA expor ao navegador.
SUPABASE_SERVICE_ROLE_KEY=
WAHA_URL=http://127.0.0.1:3031
WAHA_API_KEY=
WAHA_SESSION=default
# Segredo (HMAC) que o WAHA usa para assinar cada webhook; o mesmo valor vai na configuração do webhook do WAHA
WAHA_HMAC_SECRET=
